[Unit]
Description=AutoApply Next.js web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/autoapply/apps/web
Environment=NODE_ENV=production
Environment=PORT=3600
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/opt/autoapply/apps/web/.env.production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3600
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
